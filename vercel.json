{
  "version": 2,
  "name": "bala-portfolio",
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "port.html"
    }
  ],
  "env": {
    "VERCEL_ENV": "production"
  },
  "public": true
}
